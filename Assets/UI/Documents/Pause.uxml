<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/DesignSystem/Resources/UI/Styles/DesignSystem/DesignSystem.uss" />
    <Style src="project://database/Assets/UI/Styles/DriftTheme.uss" />

    <!-- Pause screen. Full-screen dimmed backdrop centring the modal. -->
    <ui:VisualElement name="pause-root" class="ds-root mobile dt-overlay-root">
        <ui:VisualElement name="dt-pause-backdrop" class="ds-backdrop">

            <ui:VisualElement name="dt-pause-modal" class="ds-modal dt-modal">

                <ui:VisualElement class="ds-modal__header" style="justify-content: center;">
                    <ui:Label text="Paused" class="ds-h2 ds-modal__title" />
                </ui:VisualElement>

                <ui:VisualElement name="dt-pause-actions" class="dt-actions-col">
                    <ui:Button name="dt-resume-btn" text="Resume" class="ds-btn ds-btn--primary ds-btn--block dt-action" />
                    <ui:Button name="dt-restart-btn-pause" text="Restart" class="ds-btn ds-btn--secondary ds-btn--block dt-action" />
                    <ui:Button name="dt-quit-btn" text="Quit" class="ds-btn ds-btn--ghost ds-btn--block dt-action" />
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
